# ---- never commit the real .env ----
HL_ENV=testnet                       # testnet | mainnet
HL_ACCOUNT_ADDRESS=0x...             # MASTER account address (holds the funds)
HL_API_SECRET=0x...                  # API/agent wallet private key (trade-only; no withdrawals)
HL_COIN=BTC
HL_DRY_RUN=1                         # 1 = real market data, orders are only logged
HL_FLATTEN_ON_EXIT=1
# mainnet only (bot refuses to start without it):
# HL_CONFIRM_MAINNET=YES_ISOLATED_WALLET
# Optional overrides: MM_<FIELD> for StrategyParams, RISK_<FIELD> for RiskConfig, e.g.
# MM_HALF_SPREAD_BPS=5   RISK_MAX_DRAWDOWN_PCT=0.03

# 24h circuit breaker: pause new entries after a realized loss above this USD amount
HL_LOSS_COOLDOWN_USD=0.25
HL_COOLDOWN_HOURS=24

# ---- MM cooldown / circuit-breaker plugins (optional) ----
# Active plugin: cooldown_6h | cooldown_12h | cooldown_24h_4blocks
# Leave empty/unset to run the MM engine with no cooldown plugin.
MM_COOLDOWN_PLUGIN=
# Loss threshold that arms the breaker (USD). Default 0.25.
MM_COOLDOWN_LOSS_USD=0.25
# Optional override of the plugin's built-in window length.
# MM_COOLDOWN_HOURS=6
# Directory for persisted cooldown state. Default data/cooldowns.
# MM_COOLDOWN_STATE_DIR=/root/hl-mm-bot/data/cooldowns
