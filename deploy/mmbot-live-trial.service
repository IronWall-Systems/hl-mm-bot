[Unit]
Description=HYPE live micro-notional trading trial
Documentation=file:///root/hl-mm-bot-live-safety-trial/scripts/live_trial_20261107.py
After=network-online.target mmbot-microstructure.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/hl-mm-bot-live-safety-trial
Environment=PYTHONPATH=/root/hl-mm-bot-live-safety-trial/src
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/root/hl-mm-bot/venv/bin/python scripts/live_trial_20261107.py
# A kill-switch halt must stay halted until an operator decides. Auto-restart
# would fight the risk guard and the exchange request budget.
Restart=no
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=65536
MemoryMax=256M
CPUQuota=50%
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/hl-mm-bot-live-safety-trial/logs
StandardOutput=append:/root/hl-mm-bot-live-safety-trial/logs/live_trial_20261107_hype.console.log
StandardError=append:/root/hl-mm-bot-live-safety-trial/logs/live_trial_20261107_hype.console.log

[Install]
WantedBy=multi-user.target
