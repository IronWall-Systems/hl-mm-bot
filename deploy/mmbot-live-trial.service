[Unit]
Description=HYPE live micro-notional trading trial
Documentation=file:///root/hl-mm-bot/scripts/live_trial_20261107.py
After=network-online.target mmbot-microstructure.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/hl-mm-bot
Environment=PYTHONPATH=/root/hl-mm-bot/src
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Durable hard-stop marker (logs/ is the unit's only writable path).
Environment=RISK_HALT_FILE=/root/hl-mm-bot/logs/HALT
# Refuse to start while a hard-stop HALT marker exists.  Requires an operator
# to inspect the flatten result and remove the file deliberately.
ExecStartPre=/usr/bin/test ! -e /root/hl-mm-bot/logs/HALT
ExecStart=/root/hl-mm-bot/venv/bin/python scripts/live_trial_20261107.py
# A kill-switch halt must stay halted until an operator decides. Auto-restart
# would fight the risk guard and the exchange request budget.
Restart=no
# Belt-and-suspenders if Restart is ever changed to on-failure.
RestartPreventExitStatus=2 3 4
TimeoutStopSec=30
KillSignal=SIGTERM
LimitNOFILE=65536
MemoryMax=256M
CPUQuota=50%
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/hl-mm-bot/logs
StandardOutput=append:/root/hl-mm-bot/logs/live_trial_20261107_hype.console.log
StandardError=append:/root/hl-mm-bot/logs/live_trial_20261107_hype.console.log

[Install]
WantedBy=multi-user.target